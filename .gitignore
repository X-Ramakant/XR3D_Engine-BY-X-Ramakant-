# ========================================================== 
# XR3D Engine - .gitignore 
# Ignores everything that is auto-generated by build/debug/IDE. 
# Only hand-written source, headers, CMakeLists.txt, docs, assets 
# should ever be tracked. 
# ========================================================== 
 
# ---- CMake build output ---- 
build/ 
Build/ 
out/ 
cmake-build-*/ 
 
# ---- CMake generated files (safety, in case of in-source config) ---- 
CMakeFiles/ 
CMakeCache.txt 
cmake_install.cmake 
CTestTestfile.cmake 
install_manifest.txt 
Testing/ 
 
# ---- Visual Studio generated project/solution files ---- 
*.sln 
*.vcxproj 
*.vcxproj.filters 
*.vcxproj.user 
*.suo 
*.user 
*.sdf 
*.opensdf 
*.VC.db 
*.VC.VC.opendb 
.vs/ 
 
# ---- Build configuration folders ---- 
[Dd]ebug/ 
[Rr]elease/ 
x64/ 
x86/ 
[Bb]in/ 
[Oo]bj/ 
 
# ---- Compiled binaries and intermediate files ---- 
*.obj 
*.o 
*.exe 
*.dll 
*.lib 
*.pdb 
*.ilk 
*.exp 
*.idb 
*.iobj 
*.ipdb 
*.pgc 
*.pgd 
*.tlog 
*.log 
 
# ---- Qt auto-generated files (for later Editor/UI work) ---- 
moc_*.cpp 
qrc_*.cpp 
ui_*.h 
*.qmlc 
*.jsc 
 
# ---- Vulkan compiled shader output (for later Rendering work) ---- 
*.spv 
 
# ---- Other IDEs ---- 
.idea/ 
*.iml 
 
# ---- OS-specific junk ---- 
Thumbs.db 
.DS_Store 
